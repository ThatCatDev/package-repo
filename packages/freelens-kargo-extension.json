  "packageJson": {
    "name": "@freelensapp/kargo-extension",
    "version": "0.2.0",
    "description": "Freelens extension for Kargo",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/jhajali/freelens-kargo-extension.git",
      "directory": "."
    },
    "main": "dist/main.js",
    "renderer": "dist/renderer.js",
    "files": [
