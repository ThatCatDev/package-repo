      "jsdom": "30.1.2",
      "mobx": "7.0.6",
      "mobx-react": "10.0.2",
      "monaco-editor": "0.57.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "react-markdown": "^10.1.0",
      "remark-gfm": "^4.0.1",
      "sass-embedded": "1.105.1",
      "typescript": "7.0.2",
      "vite": "8.3.4",
      "vitest": "5.0.4",
      "yaml": "^2.9.1",
      "zod": "4.6.7"
    },
