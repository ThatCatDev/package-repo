      "@types/react": "^17.0.90",
      "@vitejs/plugin-react": "^5.1.1",
      "electron-vite": "^4.0.1",
      "mobx": "6.13.7",
      "mobx-react": "7.6.0",
      "react": "17.0.2",
      "sass": "^1.94.1",
      "typescript": "5.9.3",
      "vite": "^7.2.2",
      "vite-plugin-external": "^6.2.2",
      "vite-plugin-sass-dts": "^1.3.34"
    },
    "keywords": [
      "extension",
      "freelensapp",
      "lens",
      "openlens",
      "freelens"
    ],
    "packageManager": "pnpm@10.22.0",
    "pnpm": {
