    "name": "@freelensapp/kafka-extension",
    "version": "2.0.0-0",
    "description": "Freelens extension for Apache Kafka",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/freelensapp/freelens-kafka-extension.git",
      "directory": "."
    },
